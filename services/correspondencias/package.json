{
  "name": "reencontra-correspondencias",
  "version": "0.1.0",
  "private": true,
  "description": "Consumidor de eventos e gerador de correspondências do Reencontra",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^0.10.8",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
