generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusBusca {
  ATIVA
  ARQUIVADA
}

// usuarioId é uma referência lógica ao serviço de Autenticação. Cada
// microsserviço mantém seu próprio banco e não cria FK entre bancos.
model Busca {
  id                    String      @id @default(uuid()) @db.Uuid
  usuarioId             String      @map("usuario_id") @db.VarChar(64)
  categoria             String      @db.VarChar(60)
  categoriaNormalizada  String      @map("categoria_normalizada") @db.VarChar(60)
  palavrasChave         String[]    @map("palavras_chave")
  palavrasNormalizadas  String[]    @map("palavras_normalizadas")
  localPerdido          String?     @map("local_perdido") @db.VarChar(120)
  dataInicio            DateTime?   @map("data_inicio") @db.Date
  dataFim               DateTime?   @map("data_fim") @db.Date
  status                StatusBusca @default(ATIVA)
  criadoEm              DateTime    @default(now()) @map("criado_em")
  atualizadoEm          DateTime    @updatedAt @map("atualizado_em")
  arquivadaEm           DateTime?   @map("arquivada_em")

  @@index([usuarioId, status, criadoEm])
  @@index([status, categoriaNormalizada])
  @@map("buscas")
}

// A busca e o evento de criação são gravados no mesmo commit para não perder
// a varredura de publicações se o RabbitMQ estiver temporariamente indisponível.
model OutboxEvento {
  id               String    @id @default(uuid()) @db.Uuid
  tipo             String    @db.VarChar(120)
  payload          Json
  criadoEm         DateTime  @default(now()) @map("criado_em")
  tentativas       Int       @default(0)
  proximaTentativa DateTime  @default(now()) @map("proxima_tentativa")
  publicadoEm      DateTime? @map("publicado_em")

  @@index([publicadoEm, proximaTentativa, criadoEm])
  @@map("outbox_eventos")
}
