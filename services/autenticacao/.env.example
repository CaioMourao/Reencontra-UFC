# Copie para .env e ajuste. NUNCA faça commit do .env.
NODE_ENV=development
PORT=3001
GRPC_PORT=50051

DATABASE_URL=postgresql://reencontra:reencontra@localhost:5432/auth_db?schema=public

# Obrigatório (o serviço não sobe sem ele). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Não deixe um texto fixo aqui: com um segredo conhecido qualquer um forja tokens.
JWT_SECRET=
JWT_ISSUER=reencontra-autenticacao
JWT_AUDIENCE=reencontra
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DIAS=7

# Origens do front que podem chamar a API (separe por vírgula)
CORS_ORIGINS=http://localhost:5173
# 1 quando estiver atrás do Nginx; 0 rodando direto
TRUST_PROXY=0
# Caminho público da API de autenticação no navegador (o cookie de refresh só vai para ele)
COOKIE_PATH=/api/auth
BCRYPT_CUSTO=12
