# Copie para .env (que não vai para o Git) e preencha.
#
# JWT_SECRET: pelo menos 32 caracteres. Gere com:
#   openssl rand -base64 48
JWT_SECRET=
# AUTH_DB_PASSWORD: use só letras e números (hex), porque ela entra na
# DATABASE_URL e caracteres como "/" do base64 quebram a URL. Gere com:
#   openssl rand -hex 24
AUTH_DB_PASSWORD=
# PUBLICACOES_DB_PASSWORD: credencial exclusiva do banco de Publicações.
# Gere com: openssl rand -hex 24
PUBLICACOES_DB_PASSWORD=
# RabbitMQ: o usuário padrão é reencontra; gere a senha com openssl rand -hex 24.
RABBITMQ_USER=reencontra
RABBITMQ_PASSWORD=
# Segredo independente para proteger os códigos de retirada (32 bytes aleatórios).
# Gere com: openssl rand -hex 32
PUBLICACOES_CODE_SECRET=
# Opcional: domínios permitidos separados por vírgula; vazio aceita qualquer domínio.
ALLOWED_EMAIL_DOMAINS=
# Recuperação de senha por e-mail (Resend).
# Use um remetente de domínio verificado na sua conta Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Docker: http://localhost:8080. Com Vite local, use http://localhost:5173.
APP_BASE_URL=http://localhost:8080
