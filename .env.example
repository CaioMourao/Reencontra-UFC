# Copie para .env (que não vai para o Git) e preencha.
#
# JWT_SECRET: pelo menos 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# AUTH_DB_PASSWORD: use só letras e números (hex), porque ela entra na
# DATABASE_URL e caracteres como "/" do base64 quebram a URL. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTH_DB_PASSWORD=
